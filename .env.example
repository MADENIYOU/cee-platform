# Copier en .env et remplir. Ne jamais committer le .env réel (voir .gitignore).

# --- Base de données ---
# En dev local (docker-compose.dev.yml) : postgresql://cee:cee@localhost:5432/cee_platform?schema=core
DATABASE_URL="postgresql://cee:cee@localhost:5432/cee_platform?schema=core"

# --- Auth.js ---
# Générer avec: npx auth secret
AUTH_SECRET=""
# En dev local, pointe sur le Keycloak du docker-compose (realm "cee-dev").
# En prod, pointe sur le moteur d'auth partagé de l'écosystème (voir Authentification-CEE.md).
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/cee-dev"
AUTH_KEYCLOAK_ID="cee-platform-web"
AUTH_KEYCLOAK_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Stockage fichiers (Cloudflare R2, API compatible S3) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="cee-platform-uploads"
# Domaine public du bucket (pour la CSP img-src), ex: https://pub-xxxx.r2.dev
R2_PUBLIC_DOMAIN=""

# --- Rate limiting (Upstash Redis, offre gratuite) ---
# Laisser vide en dev : fallback mémoire automatique (voir src/lib/rate-limit.ts).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Divers ---
NODE_ENV="development"
